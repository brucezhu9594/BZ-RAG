# OPENAI
OPENAI_API_KEY=XXX
OPENAI_BASE_URL=XXX
MODEL_ID=XXX

# 智谱Embedding
ZHIPUAI_API_KEY=XXX
# 智谱OCR
ZAI_API_KEY=XXX

# Langfuse Cloud（链路追踪与 dataset 平台）
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Confident AI（DeepEval 云端报告，可选）
# CONFIDENT_API_KEY=your_confident_ai_key
# Phoenix 评估判官（OpenAI 兼容端点；实测 Vercel AI Gateway + minimax/minimax-m3）
JUDGE_OPENAI_API_KEY=XXX
JUDGE_OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
JUDGE_MODEL_ID=minimax/minimax-m3

# Phoenix 本地自托管（localhost 必须进 NO_PROXY，否则被本机代理拦）
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=bz-rag-ci
# PHOENIX_ENDPOINT 和上面的 PHOENIX_COLLECTOR_ENDPOINT 是两个不同的键，分工不同：
# PHOENIX_COLLECTOR_ENDPOINT 被 OTel 导出读（phoenix/otel/otel.py）；
# PHOENIX_ENDPOINT 是 phoenix.client.Client（phoenix/client/utils/config.py）取
# base URL 时的第一优先级键，缺失时该客户端会退回读 PHOENIX_COLLECTOR_ENDPOINT
# （已读源码确认，arize-phoenix-client 3.4.0）。本地自托管两者同址，显式写全
# 两个键，避免依赖这条隐式 fallback、也避免跨版本行为不一致。
PHOENIX_ENDPOINT=http://localhost:6006
